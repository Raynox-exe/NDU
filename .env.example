# NDU Library — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ── Server ────────────────────────────────────────────────────
PORT=3000
JWT_SECRET=change_this_to_a_long_random_secret_string

# ── MySQL Database (XAMPP) ────────────────────────────────────
# Uncomment the lines below to switch from JSON file to MySQL.
# Make sure XAMPP MySQL is running and you've run:
#   1. database/schema.sql  in phpMyAdmin
#   2. node database/migrate.js  (to import existing data)
#
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=ndu_library
